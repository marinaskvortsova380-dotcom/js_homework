    {
      "name": "Login_SM",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response time is less than 1000ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);\r",
              "}); \r",
              "\r",
              "pm.test(\"Request returns 200\", function () {\r",
              "    pm.expect(pm.response.code).to.equal(200);\r",
              "    }); \r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "let data = pm.environment.get(\"data\");\r",
              "let index = pm.environment.get(\"index\");\r",
              "\r",
              "if (!data) {\r",
              "    const email = `test${Date.now()}@test.com`;\r",
              "\r",
              "    data = [\r",
              "        {\r",
              "            casename: \"empty name\",\r",
              "            body: {\r",
              "                name: \"\",\r",
              "                lastName: \"Test\",\r",
              "                email: email,\r",
              "                password: \"Qwerty12345\",\r",
              "                repeatPassword: \"Qwerty12345\"\r",
              "            },\r",
              "            expectedMessage: \"Name is required\",\r",
              "            expectedCode: 200\r",
              "        },\r",
              "        {\r",
              "            casename: \"empty lastName\",\r",
              "            body: {\r",
              "                name: \"Test\",\r",
              "                lastName: \"\",\r",
              "                email: email,\r",
              "                password: \"Qwerty12345\",\r",
              "                repeatPassword: \"Qwerty12345\"\r",
              "            },\r",
              "            expectedMessage: \"Last name is required\",\r",
              "            expectedCode: 200\r",
              "        },\r",
              "        {\r",
              "            casename: \"empty password\",\r",
              "            body: {\r",
              "                name: \"Test\",\r",
              "                lastName: \"Test\",\r",
              "                email: email,\r",
              "                password: \"\",\r",
              "                repeatPassword: \"\"\r",
              "            },\r",
              "            expectedMessage: \"Password required\",\r",
              "            expectedCode: 200\r",
              "        },\r",
              "        {\r",
              "            casename: \"password mismatch\",\r",
              "            body: {\r",
              "                name: \"Test\",\r",
              "                lastName: \"Test\",\r",
              "                email: email,\r",
              "                password: \"Qwerty12345\",\r",
              "                repeatPassword: \"Qwerty1234567\"\r",
              "            },\r",
              "            expectedMessage: \"Passwords do not match\",\r",
              "            expectedCode: 200\r",
              "        },\r",
              "        {\r",
              "            casename: \"empty mail\",\r",
              "            body: {\r",
              "                name: \"Test\",\r",
              "                lastName: \"Test\",\r",
              "                email: \"\",\r",
              "                password: \"Qwerty12345\",\r",
              "                repeatPassword: \"Qwerty12345\"\r",
              "            },\r",
              "            expectedMessage: \"Email required\",\r",
              "            expectedCode: 200\r",
              "        }\r",
              "    ];\r",
              "\r",
              "    pm.environment.set(\"data\", JSON.stringify(data));\r",
              "    pm.environment.set(\"index\", 0);\r",
              "    index = 0;\r",
              "} else {\r",
              "    data = JSON.parse(data);\r",
              "    index = Number(index);\r",
              "\r",
              "    if (index >= data.length) {\r",
              "        Postman.setNextRequest(null);\r",
              "    } else {\r",
              "        const current = data[index];\r",
              "            \r",
              "pm.variables.set(\"requestBody\", JSON.stringify(current.body));\r",
              "pm.variables.set(\"caseName\", current.casename);\r",
              "pm.variables.set(\"expectedMessage\", current.expectedMessage);\r",
              "pm.variables.set(\"expectedCode\", current.expectedCode);\r",
              "    }   \r",
              "}   "
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
